# Copy to .env and fill in. .env is gitignored. On the Fly box these are Fly secrets instead:
#   fly secrets set KEY=value -a dg-devrel-deepgram-changelog
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Pushover, for the ✅/❌ push at the end of every weekly run (scripts/alerts.py).
# Token: the application's API token (pushover.net/apps). User: your user key (pushover.net home).
CHANGELOG_PUSHOVER_TOKEN=
CHANGELOG_PUSHOVER_USER=
